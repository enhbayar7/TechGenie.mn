rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ЗААВАЛ СОЛИНО: админы имэйл (Authentication дээр үүсгэсэн имэйл)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ADMIN_EMAIL@gmail.com';
    }

    // Бүрэн захиалга (нэр, утас, имэйл). Зөвхөн админ уншина.
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.id == orderId
        && request.resource.data.status == 'booked'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && request.resource.data.services is list
        && request.resource.data.services.size() > 0
        && request.resource.data.services.size() <= 7;
    }

    // Хэрэглэгчид харагдах хувилбар (утас, имэйл ОРООГҮЙ).
    // Хэрэглэгч зөвхөн кодоо мэдэж байгаа ганц захиалгыг уншина, жагсаалт харахгүй.
    match /track/{orderId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.id == orderId
        && request.resource.data.status == 'booked'
        && !('phone' in request.resource.data)
        && !('email' in request.resource.data)
        && !('address' in request.resource.data)
        && !('desc' in request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Цаг бүрийн захиалгын тоо (нэг цагт хамгийн ихдээ 2). Хувийн мэдээлэлгүй.
    match /slots/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.count == 1;
      allow update: if isAdmin()
        || (request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= 2);
      allow delete: if isAdmin();
    }
  }
}
